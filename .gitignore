# Default: do not sync anything unless it is explicitly allowed below.
*

# Repository rule file
!.gitignore

# Track empty project structure
!skills/
!skills/.gitkeep
!skills/**/
!skills/**/*
!scripts/
!scripts/.gitkeep
!scripts/STORY-REFERENCE.md
!storyboards/
!storyboards/.gitkeep
!storyboards/*.md
!prompts/
!prompts/.gitkeep
!prompts/EP*.md
!segment_mapping/
!segment_mapping/.gitkeep
!segment_mapping/EP*.md
!asset_registry/
!asset_registry/**/
!asset_registry/**/.gitkeep
!asset_registry/**/*.json

# Project skills used by Codex
!.agents/
!.agents/skills/
!.agents/skills/**

# General prompt notes, when this folder is added
!notes/
!notes/**/
!notes/**/*[Pp]rompt*.md

# Final episode scripts, when this structure is added
!scripts/
!scripts/final/
!scripts/final/EP*.md

# Legacy visual reference at project root
!*视觉摄影与场景风格分析.md

# Local video renders must never be committed
/videos/
