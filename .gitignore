# Default: do not sync anything unless it is explicitly allowed below.
*

# Repository rule file
!.gitignore

# Track empty project structure
!skills/
!skills/.gitkeep
!skills/**/
!skills/**/*
!scripts/
!scripts/.gitkeep
!storyboards/
!storyboards/.gitkeep
!segment_mapping/
!segment_mapping/.gitkeep
!segment_mapping/EP*.md

# Project skills used by Codex
!.agents/
!.agents/skills/
!.agents/skills/**

# General prompt notes, when this folder is added
!notes/
!notes/**/
!notes/**/*[Pp]rompt*.md

# Versioned episode storyboards, when this structure is added
!storyboards/
!storyboards/v*/
!storyboards/v*/EP*.md

# Final episode scripts, when this structure is added
!scripts/
!scripts/final/
!scripts/final/EP*.md

# Text-only asset registries, when this structure is added
!assets/
!assets/registry/
!assets/registry/**/
!assets/registry/**/*.json

# Current The Lost Sky Pirate director storyboard and visual reference at project root
!EP*_导演分镜故事板.md
!*视觉摄影与场景风格分析.md
